@model CampusApp.ViewModels.StudentIndexViewModel

@{
    ViewBag.Title = "Students";
}

<h2>Students</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

@using (Html.BeginForm("Index", "Students", FormMethod.Get, new { @class = "d-flex align-items-center gap-2 mb-2" }))
{
    <label for="Campus" class="mb-0">Filter by campus:</label>
    @Html.DropDownListFor(vm => vm.Campus, Model.CampusFilterItems, "All", new { @class = "form-select w-auto" })
    <input type="submit" value="Filter" class="btn btn-primary" />
    <input type="hidden" name="Search" id="Search" value="@Model.Search" />
}

@if (!String.IsNullOrEmpty(Model.Search))
{
    <p class="text-muted">Showing results for "@Model.Search"</p>
}

<table class="table">
    <tr>
        <th>
            Campus
        </th>
        <th>
            Student Name
        </th>
        <th>
            Address
        </th>
        <th></th>
    </tr>

@foreach (var item in Model.Students) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Campus.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Address)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Details", "Details", new { id=item.ID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.ID })
        </td>
    </tr>
}

</table>
